---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { ClientRouter } from "astro:transitions";
const {
    title = SITE_TITLE,
    description = SITE_DESCRIPTION,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
        <ClientRouter />
    </head>
    <body transition:animate="none" id="top">
        <Header />
        <main>
            <div class="content">
                <slot />
            </div>
        </main>
        <Footer />
    </body>
</html>

<script is:inline src="https://cdn.jsdelivr.net/npm/twemoji@14.0.2/dist/twemoji.min.js"></script>
<script is:inline>
    const parseTwemoji = () => {
        if (!window.twemoji) return;
        window.twemoji.parse(document.body, {
            folder: 'svg',
            ext: '.svg'
        });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', parseTwemoji, { once: true });
    } else {
        parseTwemoji();
    }

    document.addEventListener('astro:after-swap', parseTwemoji);
</script>