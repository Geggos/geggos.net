---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Main from './Main.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<Main title={title} description={description}>
	<article class="blog-post shadow-md my-8">
		<div class="hero-image">
			{heroImage && <Image width={1000} height={400} src={heroImage} alt="" />}
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
				<p class="text-left">{description}</p>
				<hr />
			</div>
			<slot />
		</div>
	</article>
</Main>

<style>
	.blog-post {
		border: 4px solid var(--bg-accent-transparent);
		border-radius: 16px;
		overflow: hidden;
		background-color: white;
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.prose {
		max-width: 760px;
		margin: 0 auto;
		padding: 1.25rem;
		line-height: 1.65;
	}

	.title {
		margin-bottom: 1rem;
		text-align: center;
	}

	.date {
		margin-bottom: 0.75rem;
		font-weight: 600;
		color: var(--accent-secondary-inactive);
	}

	.last-updated-on {
		margin-top: 0.25rem;
		font-style: italic;
	}

	.prose :global(h1),
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4),
	.prose :global(h5),
	.prose :global(h6) {
		margin-top: 1.5em;
		margin-bottom: 0.55em;
		line-height: 1.25;
		font-weight: 700;
		text-align: left;
		text-shadow: none;
		cursor: default;
		transform: none;
		width: auto;
		align-self: auto;
		user-select: text;
	}

	.prose :global(h1) {
		font-size: 2rem;
		color: var(--accent-secondary);
	}

	.prose :global(h2) {
		font-size: 1.6rem;
		color: var(--accent-secondary);
	}

	.prose :global(h3) {
		font-size: 1.35rem;
		color: var(--accent-secondary-inactive);
	}

	.prose :global(h4) {
		font-size: 1.15rem;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(blockquote),
	.prose :global(pre) {
		margin: 0.95em 0;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5em;
	}

	.prose :global(ul) {
		list-style: disc;
	}

	.prose :global(ol) {
		list-style: decimal;
	}

	.prose :global(li + li) {
		margin-top: 0.35em;
	}

	.prose :global(a) {
		color: var(--accent-secondary);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.prose :global(a:hover) {
		color: var(--accent-secondary-inactive-hover);
	}

	.prose :global(hr) {
		width: 100%;
		opacity: 0.2;
		margin: 1.5em 0;
	}

	.prose :global(blockquote) {
		border-left: 4px solid var(--bg-accent);
		padding: 0.25em 1em;
		color: var(--accent-secondary-inactive);
		font-style: italic;
		background-color: var(--bg-accent-transparenter);
		border-radius: 0 10px 10px 0;
	}

	.prose :global(code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		font-size: 0.92em;
		background-color: var(--bg-accent-transparenter);
		padding: 0.1em 0.35em;
		border-radius: 6px;
	}

	.prose :global(pre) {
		padding: 0.9em;
		overflow-x: auto;
		border-radius: 12px;
		background-color: #fff6ff;
	}

	.prose :global(pre code) {
		background-color: transparent;
		padding: 0;
	}

	.prose :global(img:not(.emoji)) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.2em auto;
		border-radius: 12px;
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		display: block;
		overflow-x: auto;
		margin: 1em 0;
	}

	.prose :global(th),
	.prose :global(td) {
		border: 2px solid var(--bg-accent);
		padding: 0.45em 0.6em;
		text-align: left;
	}

	.prose :global(th) {
		background-color: var(--bg-accent-transparenter);
	}

	.prose :global(.footnotes) {
		margin-top: 2em;
		padding-top: 1em;
		border-top: 2px dashed var(--bg-accent);
	}

	.prose :global(.footnotes ol) {
		padding-left: 1.5em;
	}

	.prose :global(.footnotes li) {
		margin: 0.6em 0;
	}

	.prose :global(.footnotes li > p) {
		display: inline;
		margin: 0;
	}

	.prose :global(.footnotes li > p + a),
	.prose :global(.footnotes li > a[data-footnote-backref]) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-left: 0.45em;
		padding: 0.08em 0.45em;
		line-height: 1.2;
		border-radius: 999px;
		text-decoration: none;
		background-color: var(--bg-accent-transparenter);
		border: 1px solid var(--bg-accent);
	}

	.prose :global(a[data-footnote-backref] img.emoji),
	.prose :global(.footnotes li > p + a img.emoji) {
		display: inline-block;
		width: 0.95em;
		height: 0.95em;
		margin: 0;
		vertical-align: middle;
		border-radius: 0;
	}

	.prose :global(.footnotes) {
		padding-top: 0;
	}
</style>
