---
const today = new Date();
---

<footer>
    <div class="flex flex-col md:flex-row px-4 py-6 items-center justify-between md:px-8 max-w-7xl mx-auto gap-4">
        <div class="flex flex-col gap-1">
            <span>🌻 Powered by <a href="#top" class="fancy geggos">Geggos</a></span>
            <span>🍏 Artwork by <a href="https://buh.moe" target="_blank" class="fancy kiri">halfcharr</a></span>
        </div>
        <div class="flex flex-col gap-1 items-center text-center md:text-right">
            <span>❤️ Website by <a href="https://buh.moe" target="_blank" class="fancy amemoia">amemoia</a></span>
            <a href="/private-policy" class="fancy">Private Policy</a>
        </div>
    </div>
</footer>
<style>
    footer {
        border-top: 2px dashed var(--bg-accent);
        background-color: var(--bg-accent-transparent);
        box-shadow: rgba(0, 0, 0, 0.05) 0px -3px 3px;
    }
    footer > div {
        width: 100%;
    }
    .amemoia {
        color: hsl(354, 45%, 54%) !important;
    }
    .amemoia:hover {
        color: hsl(354, 55%, 54%) !important;
    }
    .geggos {
        color: hsl(47, 85%, 50%) !important;
    }
    .geggos:hover {
        color: hsl(47, 85%, 60%) !important;
    }
    .kiri {
        color: hsl(90, 45%, 50%) !important;
    }
    .kiri:hover {
        color: hsl(90, 55%, 50%) !important;
    }
</style>
