---
import { Image } from "astro:assets";
import stamp_rhi from "../assets/stamps/stamps_rhi.png";
import stamp_buh from "../assets/stamps/stamps_buh.png";
import stamp_creampuffs from "../assets/stamps/stamps_creampuffs.png";

const today = new Date();
---

<footer>
    <div class="flex flex-col md:flex-row px-4 py-6 items-center justify-between md:px-8 max-w-7xl mx-auto gap-1 md:gap-4">
        <div class="flex flex-col gap-1 text-center md:text-left">
            <span>🌻 Powered by <a href="#top" class="fancy geggos">Geggos</a></span>
            <span>❤️ Website by <a href="https://buh.moe" target="_blank" class="fancy amemoia">amemoia</a></span>
        </div>
        <div class="flex flex-row items-center justify-center w-50 my-4 md:my-0 gap-4">
            <a href="https://rhioker.net" target="_blank" class="friend-stamp">
                <Image src={stamp_rhi} alt="Rhioker" />
            </a>
            <a href="https://buh.moe" target="_blank" class="friend-stamp">
                <Image src={stamp_buh} alt="amemoia" />
            </a>
            <a href="https://creampuffs.nekoweb.org" target="_blank" class="friend-stamp">
                <Image src={stamp_creampuffs} alt="Creampuffs" />
            </a>
        </div> 
        <div class="flex flex-col gap-1 items-center md:items-end text-center md:text-right">
            <a href="/private-policy" class="fancy w-full text-right">Private Policy</a>
            <span>&copy; 2026 BerryCo</span>
        </div>
    </div>
</footer>
<style>
    .friend-stamp {
        filter: drop-shadow(0 0 2px #00000080);
        transition: transform 0.1s ease-in-out;
    }
    .friend-stamp:hover {
        transform: translateY(-2px);
    }
    .friend-stamp:active {
        transform: translateY(-2px);
        transform: scale(0.9);
    }
    .friend-stamp img {
        pointer-events: none;
    }
    footer {
        border-top: 2px dashed var(--bg-accent);
        background-color: var(--bg-accent-transparent);
        box-shadow: rgba(0, 0, 0, 0.05) 0px -3px 3px;
    }
    footer > div {
        width: 100%;
    }
    .amemoia {
        color: hsl(354, 45%, 54%) !important;
    }
    .amemoia:hover {
        color: hsl(354, 55%, 54%) !important;
    }
    .geggos {
        color: hsl(47, 85%, 50%) !important;
    }
    .geggos:hover {
        color: hsl(47, 85%, 60%) !important;
    }
    .kiri {
        color: hsl(90, 45%, 50%) !important;
    }
    .kiri:hover {
        color: hsl(90, 55%, 50%) !important;
    }
</style>
