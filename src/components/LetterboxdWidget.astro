---
export const prerender = false;

import { Icon } from "astro-icon/components";
import FormattedDate from "./FormattedDate.astro";

interface Movie {
    entryTitle: string;
    entryUrl: string;
    watchedDate?: string;
    isRewatch: boolean;
    filmTitle?: string;
    filmYear?: string;
    memberRating?: string;
    posterUrl?: string;
}

const getTag = (xml: string, tag: string) =>
    xml.match(new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`))?.[1]?.trim();

const getFirst = (rss: string) =>
    rss.match(/<item>([\s\S]*?)<\/item>/)?.[1];

const parseRating = (entryTitle?: string) => {
    if (!entryTitle) return undefined;

    const starMatch = entryTitle.match(/★+/)?.[0];
    const fullStars = starMatch ? starMatch.length : 0;
    const hasHalfStar = entryTitle.includes("½");

    if (fullStars === 0 && !hasHalfStar) return undefined;

    return `${fullStars}${hasHalfStar ? ".5" : ""}`;
};

const isRewatch = (itemXml: string, entryTitle?: string) => {
    const rewatchTag = getTag(itemXml, "letterboxd:rewatch");
    if (rewatchTag) {
        return /yes|true|rewatch/i.test(rewatchTag);
    }

    if (!entryTitle) return false;

    return /rewatch|rewatched/i.test(entryTitle);
};

const getPosterUrl = (itemXml: string) => {
    const description = getTag(itemXml, "description");
    if (description) {
        const imageInDescription = description.match(/<img[^>]+src="([^"]+)"/i)?.[1];
        if (imageInDescription) return imageInDescription;
    }

    return getTag(itemXml, "letterboxd:image");
};

let movie: Movie | null = null;

try {
    const rss = await fetch("https://letterboxd.com/Geggos/rss/", {
        cache: "no-store",
    }).then((r) => r.text());

    const itemXml = getFirst(rss);
    const entryTitle = itemXml ? getTag(itemXml, "title") : undefined;

    if (itemXml && entryTitle) {
        movie = {
            entryTitle,
            entryUrl: getTag(itemXml, "link") ?? "#",
            watchedDate: getTag(itemXml, "letterboxd:watchedDate"),
            isRewatch: isRewatch(itemXml, entryTitle),
            filmTitle: getTag(itemXml, "letterboxd:filmTitle"),
            filmYear: getTag(itemXml, "letterboxd:filmYear"),
            memberRating: parseRating(entryTitle),
            posterUrl: getPosterUrl(itemXml),
        };
    }
} catch (error) {
    console.error("couldnt fetch letterboxd:", error);
}
---

<div class="letterboxd-widget">
    <div class="text-xl text-center self-center lxd-header fancy">
        Latest Movie
    </div>
    {
        movie ? (
            <div class="movie-entry shadow-md">
                {movie.posterUrl && (
                    <img
                        src={movie.posterUrl}
                        alt={movie.filmTitle ?? movie.entryTitle}
                        class="movie-icon shadow-md"
                    />
                )}
                <div class="movie-info flex flex-col gap-2 text-left">
                    <a
                        href={movie.entryUrl}
                        target="_blank"
                        class="movie-header flex flex-row gap-2"
                    >
                        <div class="font-semibold accent highlight-link">
                            {movie.filmTitle ?? movie.entryTitle}
                            {movie.filmYear ? ` (${movie.filmYear})` : ""}
                        </div>
                    </a>
                    <div id="movie-watched" class="movie-meta-row gap-y-2">
                        <span class="accent-secondary font-semibold">
                            Date:{" "}
                        </span>
                        <div class="movie-meta-item block text-sm font-semibold">
                            <Icon name="fa6-solid:calendar" />
                            {movie.watchedDate ? (
                                <FormattedDate
                                    date={
                                        new Date(
                                            `${movie.watchedDate}T00:00:00`,
                                        )
                                    }
                                />
                            ) : (
                                "idk"
                            )}
                        </div>
                        {movie.isRewatch && (
                            <div class="movie-meta-item block text-sm font-semibold">
                                <Icon name="fa6-solid:rotate-left" />
                                <span>Rewatch</span>
                            </div>
                        )}
                    </div>
                    {movie.memberRating && (
                        <div class="movie-rating flex flex-row gap-2">
                            <span class="accent-secondary font-semibold">
                                Rating:
                            </span>
                            <div class="block text-sm font-semibold">
                                <Icon name="fa6-solid:star" />
                                {movie.memberRating}
                            </div>
                        </div>
                    )}
                </div>
            </div>
        ) : (
            <div>Failed to load</div>
        )
    }
</div>

<style>
    .movie-entry {
        border: 4px solid var(--bg-accent-transparent);
        border-radius: 16px;
        padding: 1em;
        display: flex;
        flex-direction: row;
        align-items: center;
        width: 100%;
        gap: 0.75rem;
        justify-content: center;
        flex: 1;
    }

    .movie-icon {
        width: 100px;
        height: auto;
        aspect-ratio: auto 150 / 225;
        flex-shrink: 0;
        border-radius: 8px;
        border: 4px solid var(--bg-accent-transparent);
    }

    .movie-info {
        min-width: 0;
    }

    .movie-meta-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        min-width: 0;
    }

    .movie-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        white-space: nowrap;
    }

    .letterboxd-widget {
        width: 100%;
        height: 100%;
        user-select: none;
        will-change: transform;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.5em;
    }
    .lxd-header {
        color: var(--accent);
    }

    @media (hover: hover) {
        .lxd-header.fancy:hover:not(:active) {
            transform: rotate(-1deg);
        }
        .block .fancy:hover {
            transform: none !important;
        }
    }
</style>
