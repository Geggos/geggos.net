---
export const prerender = false;

import { Icon } from "astro-icon/components";
import FormattedDate from "./FormattedDate.astro";

interface Movie {
    entryTitle: string;
    entryUrl: string;
    publishedAt: string;
    watchedDate?: string;
    isRewatch: boolean;
    filmTitle?: string;
    filmYear?: string;
    memberRating?: string;
    memberLike?: string;
    tmdbMovieId?: string;
    author?: string;
    descriptionText: string;
    posterUrl?: string;
}

let movie: Movie | null = null;

try {
    const url = new URL("/api/letterboxd", Astro.url.origin);
    const res = await fetch(url.toString());
    const data = await res.json();
    if (res.ok && data && !data.error) {
        movie = data;
    }
} catch (error) {
    console.error("couldnt fetch letterboxd:", error);
}
---

<div class="letterboxd-widget">
    <div class="text-xl text-center self-center lxd-header fancy">
        Latest movie
    </div>
    {
        movie ? (
            <div class="movie-entry shadow-md">
                {movie.posterUrl && (
                    <img
                        src={movie.posterUrl}
                        alt={movie.filmTitle || movie.entryTitle}
                        class="movie-icon shadow-md"
                    />
                )}
                <div class="movie-info flex flex-col gap-2 text-left">
                    <a
                        href={movie.entryUrl}
                        target="_blank"
                        class="movie-header flex flex-row gap-2"
                    >
                        <div class="font-semibold accent highlight-link">
                            {movie.filmTitle} ({movie.filmYear})
                        </div>
                    </a>
                    <div id="movie-watched" class="flex flex-row gap-2">
                        <span class="accent-secondary font-semibold">
                            Date:{" "}
                        </span>
                        <div class="block text-sm font-semibold">
                            <Icon name="fa6-solid:calendar" />
                            {movie.watchedDate ? (
                                <FormattedDate
                                    date={
                                        new Date(
                                            `${movie.watchedDate}T00:00:00`,
                                        )
                                    }
                                />
                            ) : (
                                "idk"
                            )}
                        </div>
                        {movie.isRewatch && (
                            <div class="block text-sm font-semibold">
                                <Icon name="fa6-solid:rotate-left" />
                                <span>Rewatch</span>
                            </div>
                        )}
                    </div>
                    {movie.memberRating && (
                        <div class="movie-rating flex flex-row gap-2">
                            <span class="accent-secondary font-semibold">
                                Rating:
                            </span>
                            <div class="block text-sm font-semibold">
                                <Icon name="fa6-solid:star" />
                                {movie.memberRating}
                            </div>
                        </div>
                    )}
                </div>
            </div>
        ) : (
            <div>Failed to load</div>
        )
    }
</div>

<style>
    .movie-entry {
        border: 4px solid var(--bg-accent-transparent);
        border-radius: 16px;
        padding: 1em;
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        width: fit-content;
        align-self: center;
        gap: 0.75rem;
    }

    .movie-icon {
        width: 100px;
        height: auto;
        aspect-ratio: auto 150 / 225;
        flex-shrink: 0;
        border-radius: 8px;
        border: 4px solid var(--bg-accent-transparent);
    }

    .movie-info {
        flex: 1;
        min-width: 0;
    }

    .letterboxd-widget {
        width: 100%;
        user-select: none;
        will-change: transform;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.5em;
    }
    .lxd-header {
        color: var(--accent);
    }

    @media (hover: hover) {
        .lxd-header.fancy:hover:not(:active) {
            transform: rotate(-1deg);
        }
        .block .fancy:hover {
            transform: none !important;
        }
    }
</style>
