---
export const prerender = false;

import { Icon } from 'astro-icon/components';
import FormattedDate from './FormattedDate.astro';

interface Movie {
    entryTitle: string;
    entryUrl: string;
    publishedAt: string;
    watchedDate?: string;
    isRewatch: boolean;
    filmTitle?: string;
    filmYear?: string;
    memberRating?: string;
    memberLike?: string;
    tmdbMovieId?: string;
    author?: string;
    descriptionText: string;
    posterUrl?: string;
}

const extract = (text: string, tag: string) => text.match(new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`))?.[1]?.trim();
const stripHtml = (html: string) =>
    html
        .replace(/<!\[CDATA\[|\]\]>/g, '')
        .replace(/<[^>]*>/g, '')
        .trim();
const extractPosterUrl = (description: string) =>
    description.match(/<img[^>]+src="([^"]+)"/i)?.[1];

let movie: Movie | null = null;

try {
    const text = await fetch('https://letterboxd.com/Geggos/rss/').then(r => r.text());
    const item = text.match(/<item>([\s\S]*?)<\/item>/)?.[1];
    
    if (item && extract(item, 'title')) {
        const description = extract(item, 'description') || '';
        movie = {
            entryTitle: extract(item, 'title')!,
            entryUrl: extract(item, 'link') || '#',
            publishedAt: extract(item, 'pubDate') || '',
            watchedDate: extract(item, 'letterboxd:watchedDate'),
            //isRewatch: extract(item, 'letterboxd:rewatch') === 'Yes',
            isRewatch: true,
            filmTitle: extract(item, 'letterboxd:filmTitle'),
            filmYear: extract(item, 'letterboxd:filmYear'),
            //memberRating: extract(item, 'letterboxd:memberRating'),
            memberRating: "4.5",
            memberLike: extract(item, 'letterboxd:memberLike'),
            tmdbMovieId: extract(item, 'tmdb:movieId'),
            author: extract(item, 'dc:creator'),
            descriptionText: stripHtml(description),
            posterUrl: extractPosterUrl(description) || extract(item, 'letterboxd:image')
        };
    }
} catch (error) {
    console.error('Failed to fetch Letterboxd feed:', error);
}
---

<div class="letterboxd-widget">
    <div class="text-xl text-center self-center lxd-header fancy">Latest movie</div>
    {movie ? (
        <div class="movie-entry shadow-md">
            {movie.posterUrl && <img src={movie.posterUrl} alt={movie.filmTitle || movie.entryTitle} class="movie-icon shadow-md" />}
            <div class="movie-info flex flex-col gap-2 text-left">
                <a href={movie.entryUrl} target="_blank" class="movie-header flex flex-row gap-2">
                    <div class="font-semibold accent highlight-link">{movie.filmTitle} ({movie.filmYear})</div>
                </a>
                


                <div id="movie-watched" class="flex flex-row gap-2">
                    <span class="accent-secondary font-semibold">Date: </span>
                    <div class="block text-sm font-semibold">
                        <Icon name="fa6-solid:calendar" />
                        {movie.watchedDate ? <FormattedDate date={new Date(`${movie.watchedDate}T00:00:00`)} /> : 'idk'}
                    </div>
                    {movie.isRewatch && <div class="block text-sm font-semibold">
                        <Icon name="fa6-solid:rotate-left" />
                        <span>Rewatch</span>
                        </div>}
                </div>
                {movie.memberRating &&
                    <div class="movie-rating flex flex-row gap-2">
                        <span class="accent-secondary font-semibold">Rating:</span>
                        <div class="block text-sm font-semibold">
                            <Icon name="fa6-solid:star" />
                            {movie.memberRating}
                        </div>
                    </div>
                    }

            </div>
        </div>
    ) : (
        <div>Failed to load</div>
    )}
</div>

<style>
    .movie-entry {
        border: 4px solid var(--bg-accent-transparent);
        border-radius: 16px;
        padding: 1em;
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        width: fit-content;
        align-self: center;
        gap: 0.75rem;
    }

    .movie-icon {
        width: 100px;
        height: auto;
        aspect-ratio: auto 150 / 225;
        flex-shrink: 0;
        border-radius: 8px;
        border: 4px solid var(--bg-accent-transparent);
    }

    .movie-info {
        flex: 1;
        min-width: 0;
    }

    .letterboxd-widget {
        width: 100%;
        user-select: none;
        will-change: transform;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.5em;
    }
    .lxd-header {
        color: var(--accent);
    }

    @media (hover: hover) {
        .lxd-header.fancy:hover:not(:active) {
            transform: rotate(-1deg);
        }
        .block .fancy:hover {
            transform: none !important;
        }
    }
    
</style>