---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImageLightbox from "./ImageLightbox.astro";

interface CollageImage {
    src: ImageMetadata;
    alt: string;
    href?: string;
    classes?: string;
}

interface Props {
    images: CollageImage[];
    columns?: CollageImage[][];
    linkToSource?: boolean;
    openInNewTab?: boolean;
    columnCount?: number;
    gap?: string | number;
    outline?: boolean;
    maxImageWidth?: string | number;
    maxImageHeight?: string | number;
}

const {
    images,
    columns,
    linkToSource = false,
    openInNewTab = false,
    columnCount = 3,
    gap = "1rem",
    outline = true,
    maxImageWidth,
    maxImageHeight,
} = Astro.props;

const hasManualColumns = Array.isArray(columns) && columns.length > 0;
const effectiveColumnCount = hasManualColumns ? columns.length : columnCount;

const normalizeSize = (value: string | number | undefined, fallback: string) => {
    if (value === undefined || value === null || value === "") return fallback;
    if (typeof value === "number") return `${value}px`;
    return /^\d+(\.\d+)?$/.test(value) ? `${value}px` : value;
};

const normalizeGap = (value: string | number) => {
    if (typeof value === "number") return `${value}px`;
    return /^\d+(\.\d+)?$/.test(value) ? `${value}px` : value;
};

const resolvedGap = normalizeGap(gap);
const resolvedMaxImageWidth = normalizeSize(maxImageWidth, "100%");
const resolvedMaxImageHeight = normalizeSize(maxImageHeight, "none");

const halveSize = (value: string) => {
    if (value === "none") return "none";
    const match = value.match(/^(\d+(?:\.\d+)?)(px|rem|em|vh|vw|%)$/);
    if (!match) return value;
    const amount = parseFloat(match[1]);
    const unit = match[2];
    return `${amount / 2}${unit}`;
};

const resolvedMobileMaxImageHeight = halveSize(resolvedMaxImageHeight);
const collageOutline = outline ? "4px solid var(--bg-accent-transparent)" : "0";

const collageMaxWidth = maxImageWidth
    ? `calc(${resolvedMaxImageWidth} * ${effectiveColumnCount} + ${resolvedGap} * ${effectiveColumnCount - 1})`
    : "100%";

let lightboxImages = images;
let indexedColumns: Array<Array<{ image: CollageImage; index: number }>> = [];

if (hasManualColumns) {
    let currentIndex = 0;
    indexedColumns = columns.map((column) => column.map((image) => ({ image, index: currentIndex++ })));
    lightboxImages = indexedColumns.flat().map((entry) => entry.image);
}

const target = openInNewTab ? "_blank" : undefined;
const rel = openInNewTab ? "noreferrer" : undefined;
const lightboxId = `collage-lightbox-${Math.random().toString(36).substr(2, 9)}`;
---

<div class={`image-collage ${hasManualColumns ? "image-collage--manual" : ""}`} style={`--collage-columns: ${effectiveColumnCount}; --collage-gap: ${resolvedGap}; --collage-outline: ${collageOutline}; --collage-max-width: ${collageMaxWidth}; --collage-max-height: ${resolvedMaxImageHeight}; --collage-mobile-max-height: ${resolvedMobileMaxImageHeight};`}>
    {
        hasManualColumns
            ? indexedColumns.map((column) => (
                <div class="collage-column">
                    {
                        column.map(({ image, index }) => {
                            const href = image.href || (linkToSource ? image.src.src : undefined);

                            if (href) {
                                return (
                                    <a
                                        class="collage-item"
                                        href={href}
                                        target={target}
                                        rel={rel}
                                        data-lightbox-trigger={lightboxId}
                                        data-lightbox-index={index}
                                    >
                                        <Image src={image.src} alt={image.alt} loading="lazy" class={`collage-img ${image.classes || ""}`} />
                                    </a>
                                );
                            }

                            return (
                                <div
                                    class="collage-item"
                                    data-lightbox-trigger={lightboxId}
                                    data-lightbox-index={index}
                                    style="cursor: pointer;"
                                >
                                    <Image src={image.src} alt={image.alt} loading="lazy" class={`collage-img ${image.classes || ""}`} />
                                </div>
                            );
                        })
                    }
                </div>
            ))
            : images.map((image, index) => {
                const href = image.href || (linkToSource ? image.src.src : undefined);

                if (href) {
                    return (
                        <a
                            class="collage-item"
                            href={href}
                            target={target}
                            rel={rel}
                            data-lightbox-trigger={lightboxId}
                            data-lightbox-index={index}
                        >
                            <Image src={image.src} alt={image.alt} loading="lazy" class={`collage-img ${image.classes || ""}`} />
                        </a>
                    );
                }

                return (
                    <div
                        class="collage-item"
                        data-lightbox-trigger={lightboxId}
                        data-lightbox-index={index}
                        style="cursor: pointer;"
                    >
                        <Image src={image.src} alt={image.alt} loading="lazy" class={`collage-img ${image.classes || ""}`} />
                    </div>
                );
            })
    }
</div>

<ImageLightbox images={lightboxImages} lightboxId={lightboxId} />

<style>
    .image-collage {
        column-count: var(--collage-columns);
        column-gap: var(--collage-gap);
        width: 100%;
        max-width: var(--collage-max-width);
    }

    .image-collage--manual {
        column-count: initial;
        display: flex;
        align-items: flex-start;
        gap: var(--collage-gap);
    }

    .collage-column {
        flex: 1;
        min-width: 0;
    }

    @media (max-width: 768px) {
        .image-collage {
            column-count: 1;
        }

        .image-collage--manual {
            display: block;
        }

        .collage-img {
            max-height: var(--collage-mobile-max-height);
        }
    }

    @media (min-width: 769px) and (max-width: 1023px) {
        .image-collage {
            column-count: 2;
        }
    }

    .collage-item {
        display: block;
        overflow: hidden;
        border: var(--collage-outline);
        margin-bottom: var(--collage-gap);
        break-inside: avoid;
        width: 100%;
        transition: transform 100ms ease-out;
    }

    @media (hover: hover) {
        .collage-item:hover {
            transform: translateY(-4px);
        }

        .collage-item:active {
            transform: scale(0.98) translateY(-4px);
        }
    }

    .collage-img {
        width: 100%;
        max-height: var(--collage-max-height);
        height: auto;
        display: block;
        object-fit: contain;
    }
</style>

<script>
    // @ts-nocheck
    function openFromTrigger(event) {
        const trigger = event.currentTarget;
        if (!(trigger instanceof HTMLElement)) return;

        const lightboxId = trigger.dataset.lightboxTrigger;
        const index = Number(trigger.dataset.lightboxIndex);
        if (!lightboxId || Number.isNaN(index)) return;

        const openLightbox = window[`openLightbox_${lightboxId}`];
        if (typeof openLightbox !== "function") return;

        event.preventDefault();
        openLightbox(index);
    }

    function setupCollageLightbox(collage) {
        if (!(collage instanceof HTMLElement)) return;

        const items = collage.querySelectorAll("[data-lightbox-trigger]");
        items.forEach((item) => {
            if (!(item instanceof HTMLElement)) return;
            item.addEventListener("click", openFromTrigger);
        });
    }

    const initCollageLightbox = () => {
        document.querySelectorAll(".image-collage").forEach((collage) => {
            if (collage.dataset.collageLightboxReady === "true") return;
            setupCollageLightbox(collage);
            collage.dataset.collageLightboxReady = "true";
        });
    };

    document.addEventListener("astro:page-load", initCollageLightbox);
</script>
