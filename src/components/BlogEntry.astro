---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import FormattedDate from "./FormattedDate.astro";

interface Props {
    slug: string;
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    heroImage?: ImageMetadata;
}

const { slug, title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<a href={`/blog/${slug}/`} class="flex flex-row archive-entry shadow-md archive-entry-link">
    <div class="flex flex-col items-start self-start p-4 gap-1">
        <span class="text-2xl fancy accent-secondary">{title}</span>
        <span class="flex flex-row gap-2 flex-wrap">
            <span class="block text-sm font-semibold">
                <Icon name="fa6-solid:calendar" />
                <FormattedDate date={pubDate} />
            </span>
            {
                updatedDate && (
                    <span class="block text-sm font-semibold">
                        <Icon name="fa6-solid:clock-rotate-left" />
                        {"Updated "}
                        <FormattedDate date={updatedDate} />
                    </span>
                )
            }
        </span>
        <span class="text-left">{description}</span>
    </div>
    {
        heroImage && (
            <div class="archive-image-container">
                <Image src={heroImage} alt="" class="archive-image object-center" />
            </div>
        )
    }
</a>

<style>
    .archive-entry {
        width: 100%;
        border: 4px solid var(--bg-accent-transparent);
        border-radius: 16px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
        overflow: hidden;
        transition: transform 80ms ease-out;
        will-change: transform;
    }

    .archive-entry-link {
        text-decoration: none;
        color: inherit;
    }

    .archive-image-container {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
    }

    @media (min-width: 768px) {
        .archive-entry {
            grid-template-columns: 3fr 2fr;
            min-height: 220px;
            max-height: 220px;
        }
    }

    .archive-image {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
        min-height: 0;
        min-width: 0;
        object-fit: cover;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        mask-image: linear-gradient(to bottom, transparent 0%, white 40%);
        -webkit-mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            white 40%
        );
    }

    @media (min-width: 768px) {
        .archive-image {
            border-bottom-left-radius: 0;
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            mask-image: linear-gradient(to right, transparent 0%, white 40%);
            -webkit-mask-image: linear-gradient(
                to right,
                transparent 0%,
                white 40%
            );
        }
    }

    @media (hover: hover) {
        .archive-entry:hover {
            transform: translateY(-2px);
        }

        .archive-entry:active {
            transform: scale(0.99) translateY(-2px);
        }

        .fancy:hover:not(:active) {
            transform: rotate(-0.5deg);
            color: var(--accent-secondary);
        }

        .fancy:hover {
            color: var(--accent-secondary);
        }
    }
</style>