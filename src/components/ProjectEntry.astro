---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
    name: string;
    description: string;
    tags: Array<{ label: string; icon?: string }>;
    image: ImageMetadata;
    imageAlt: string;
    imageClass?: string;
    url?: string;
}

const { name, description, tags, image, imageAlt, imageClass, url } = Astro.props;
---

{
    url ? (
        <a href={url} class="flex flex-row archive-entry shadow-md archive-entry-link">
            <div class="flex flex-col items-start self-start p-4 gap-1">
                <span class="text-2xl fancy accent-secondary">{name}</span>
                <span class="flex flex-row gap-2">
                    {
                        tags.map((tag) => (
                            <span class="block text-sm font-semibold">
                                <Icon name={tag.icon || "fa6-solid:tag"} />
                                {tag.label}
                            </span>
                        ))
                    }
                </span>
                <span class="text-left">
                    {description}
                </span>
            </div>
            <div class="archive-image-container">
                <Image src={image} alt={imageAlt} class={`archive-image object-left ${imageClass || ""}`} />
            </div>
        </a>
    ) : (
        <div class="flex flex-row archive-entry shadow-md">
            <div class="flex flex-col items-start self-start p-4 gap-1">
                <span class="text-2xl fancy accent-secondary">{name}</span>
                <span class="flex flex-row gap-2">
                    {
                        tags.map((tag) => (
                            <span class="block text-sm font-semibold">
                                <Icon name={tag.icon || "fa6-solid:tag"} />
                                {tag.label}
                            </span>
                        ))
                    }
                </span>
                <span class="text-left">
                    {description}
                </span>
            </div>
            <div class="archive-image-container">
                <Image src={image} alt={imageAlt} class={`archive-image object-left ${imageClass || ""}`} />
            </div>
        </div>
    )
}

<style>
    .archive-entry {
        width: 100%;
        border: 4px solid var(--bg-accent-transparent);
        border-radius: 16px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
        overflow: hidden;
            transition: transform 80ms ease-out;
        will-change: transform;
    }

    .archive-entry-link {
        text-decoration: none;
        color: inherit;
    }

    .archive-image-container {
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
    }

    @media (min-width: 768px) {
        .archive-entry {
            grid-template-columns: 1fr 1fr;
            min-height: 250px;
            max-height: 250px;
        }
    }

    .archive-image {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
        min-height: 0;
        min-width: 0;
        object-fit: cover;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        mask-image: linear-gradient(to bottom, transparent 0%, white 40%);
        -webkit-mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            white 40%
        );
    }

    @media (min-width: 768px) {
        .archive-image {
            border-bottom-left-radius: 0;
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            mask-image: linear-gradient(to right, transparent 0%, white 40%);
            -webkit-mask-image: linear-gradient(
                to right,
                transparent 0%,
                white 40%
            );
        }
    }

    @media (hover: hover) {
        .archive-entry:hover {
            transform: translateY(-2px);
        }

        .archive-entry:active {
            transform: scale(0.99) translateY(-2px);
        }

        .fancy:hover:not(:active) {
            transform: rotate(-0.5deg);
            color: var(--accent-secondary);
        }
        .fancy:hover {
            color: var(--accent-secondary);
        }
    }
</style>
