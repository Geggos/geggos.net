---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImageLightbox from "./ImageLightbox.astro";

interface Props {
    src: ImageMetadata;
    alt?: string;
    rounded?: boolean;
    class?: string;
}

const {
    src,
    alt = "",
    rounded = true,
    class: imageClass = "",
} = Astro.props;

const images = [{ src, alt }];
const lightboxId = `gallery-image-lightbox-${Math.random().toString(36).substr(2, 9)}`;
const imageRadius = rounded ? "16px" : "0";
---

<div
    class="gallery-image-trigger"
    data-image-single-trigger="true"
    data-lightbox-trigger={lightboxId}
    data-lightbox-index="0"
    style={`--gallery-image-radius: ${imageRadius};`}
>
    <Image src={src} alt={alt} loading="lazy" class={`gallery-image ${imageClass}`.trim()} />
</div>

<ImageLightbox images={images} lightboxId={lightboxId} />

<style>
    .gallery-image-trigger {
        cursor: pointer;
        border-radius: var(--gallery-image-radius);
        overflow: hidden;
        transition: transform 100ms ease-out;
    }

    .gallery-image {
        width: 100%;
        height: auto;
        display: block;
    }

    @media (hover: hover) {
        .gallery-image-trigger:hover {
            transform: translateY(-4px);
        }

        .gallery-image-trigger:active {
            transform: scale(0.98) translateY(-4px);
        }
    }
</style>

<script>
    // @ts-nocheck
    function openFromTrigger(event) {
        const trigger = event.currentTarget;
        if (!(trigger instanceof HTMLElement)) return;

        const lightboxId = trigger.dataset.lightboxTrigger;
        const index = Number(trigger.dataset.lightboxIndex);
        if (!lightboxId || Number.isNaN(index)) return;

        const openLightbox = window[`openLightbox_${lightboxId}`];
        if (typeof openLightbox !== "function") return;

        event.preventDefault();
        openLightbox(index);
    }

    function setupImageSingleTrigger(trigger) {
        if (!(trigger instanceof HTMLElement)) return;
        if (trigger.dataset.imageSingleReady === "true") return;

        trigger.addEventListener("click", openFromTrigger);
        trigger.dataset.imageSingleReady = "true";
    }

    const initImageSingleTriggers = () => {
        document.querySelectorAll("[data-image-single-trigger='true']").forEach((trigger) => {
            setupImageSingleTrigger(trigger);
        });
    };

    document.addEventListener("DOMContentLoaded", initImageSingleTriggers);
    document.addEventListener("astro:after-swap", initImageSingleTriggers);
</script>