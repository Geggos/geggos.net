---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface LightboxImage {
    src: ImageMetadata;
    alt: string;
}

interface Props {
    images: LightboxImage[];
    lightboxId: string;
}

const { images, lightboxId } = Astro.props;
---

<div class="image-lightbox" data-lightbox-id={lightboxId}>
    <div class="lightbox-overlay" data-lightbox-overlay></div>
    <div class="lightbox-container" data-lightbox-container>
        <button class="lightbox-close" data-lightbox-close aria-label="Close fullscreen">✕</button>
        <button class="lightbox-prev" data-lightbox-nav="prev" aria-label="Previous image">←</button>
        <div class="lightbox-content">
            <div class="lightbox-stage" data-lightbox-stage>
                {
                    images.map((image, index) => (
                        <div class={`lightbox-slide ${index === 0 ? "is-active" : ""}`} data-lightbox-slide={index}>
                            <Image src={image.src} alt={image.alt} class="lightbox-image" />
                        </div>
                    ))
                }
            </div>
            <p class="lightbox-caption" data-lightbox-caption aria-live="polite">{images[0]?.alt || ""}</p>
        </div>
        <button class="lightbox-next" data-lightbox-nav="next" aria-label="Next image">→</button>
    </div>
</div>

<style>
    .image-lightbox {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
    }

    .image-lightbox.is-open {
        display: flex;
    }

    .lightbox-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(2px);
    }

    .lightbox-container {
        position: absolute;
        inset: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .lightbox-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }

    .lightbox-stage {
        position: relative;
        width: min(calc(100vw - 8rem), 1400px);
        height: min(82vh, calc(100vh - 6rem));
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .lightbox-slide {
        display: none;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
    }

    .lightbox-slide.is-active {
        display: flex;
    }

    .lightbox-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 8px;
    }

    .lightbox-caption {
        margin: 0;
        max-width: min(calc(100vw - 8rem), 1400px);
        color: white;
        text-align: center;
        line-height: 1.35;
        font-size: 0.95rem;
        text-wrap: balance;
    }

    .lightbox-close {
        position: fixed;
        top: 1rem;
        right: 1rem;
        width: 2.5rem;
        height: 2.5rem;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        transition: background 100ms ease-out;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
    }

    .lightbox-close:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .lightbox-close:active {
        transform: scale(0.95);
    }

    .lightbox-prev,
    .lightbox-next {
        position: fixed;
        top: 50%;
        transform: translateY(-50%);
        width: 3rem;
        height: 3rem;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
        cursor: pointer;
        transition: background 100ms ease-out;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
    }

    .lightbox-prev {
        left: 1rem;
    }

    .lightbox-next {
        right: 1rem;
    }

    .lightbox-prev:hover,
    .lightbox-next:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .lightbox-prev:active,
    .lightbox-next:active {
        transform: translateY(-50%) scale(0.95);
    }

    @media (max-width: 768px) {
        .lightbox-container {
            inset: 1rem;
            gap: 0.5rem;
        }

        .lightbox-stage {
            width: min(calc(100vw - 2rem), 100%);
            height: min(70vh, calc(100vh - 8.5rem));
        }

        .lightbox-caption {
            max-width: min(calc(100vw - 2rem), 100%);
            font-size: 0.88rem;
        }

        .lightbox-prev,
        .lightbox-next {
            width: 2.5rem;
            height: 2.5rem;
            font-size: 1.25rem;
            top: auto;
            bottom: 1rem;
            transform: none;
        }

        .lightbox-prev:active,
        .lightbox-next:active {
            transform: scale(0.95);
        }

        .lightbox-close {
            width: 2rem;
            height: 2rem;
            font-size: 1.25rem;
        }

        .lightbox-prev {
            left: 1rem;
        }

        .lightbox-next {
            right: 1rem;
        }
    }
</style>

<script>
    // @ts-nocheck idgafff
    function wrapIndex(index, size) {
        if (size === 0) return 0;
        if (index < 0) return size - 1;
        if (index >= size) return 0;
        return index;
    }

    function getSlideCaption(slide) {
        if (!(slide instanceof HTMLElement)) return "";
        const img = slide.querySelector("img");
        return img instanceof HTMLImageElement ? img.alt : "";
    }

    function setupLightbox(lightbox) {
        if (!(lightbox instanceof HTMLElement)) return;

        const lightboxId = lightbox.getAttribute("data-lightbox-id");
        if (!lightboxId) return;

        const overlay = lightbox.querySelector("[data-lightbox-overlay]");
        const caption = lightbox.querySelector("[data-lightbox-caption]");
        const closeBtn = lightbox.querySelector("[data-lightbox-close]");
        const prevBtn = lightbox.querySelector('[data-lightbox-nav="prev"]');
        const nextBtn = lightbox.querySelector('[data-lightbox-nav="next"]');
        const slides = Array.from(lightbox.querySelectorAll("[data-lightbox-slide]"));

        if (slides.length === 0) return;

        let activeIndex = 0;

        const render = () => {
            slides.forEach((slide, slideIndex) => {
                if (!(slide instanceof HTMLElement)) return;
                slide.classList.toggle("is-active", slideIndex === activeIndex);
            });

            if (caption instanceof HTMLElement) {
                caption.textContent = getSlideCaption(slides[activeIndex]);
            }
        };

        const goTo = (index) => {
            activeIndex = wrapIndex(index, slides.length);
            render();
        };

        const open = (startIndex = 0) => {
            goTo(startIndex);
            lightbox.classList.add("is-open");
            document.body.style.overflow = "hidden";
        };

        const close = () => {
            lightbox.classList.remove("is-open");
            document.body.style.overflow = "";
        };

        const onKeyDown = (event) => {
            if (!lightbox.classList.contains("is-open")) return;

            if (event.key === "Escape") close();
            if (event.key === "ArrowLeft") goTo(activeIndex - 1);
            if (event.key === "ArrowRight") goTo(activeIndex + 1);
        };

        window[`openLightbox_${lightboxId}`] = open;
        window[`closeLightbox_${lightboxId}`] = close;

        closeBtn?.addEventListener("click", close);
        overlay?.addEventListener("click", close);
        prevBtn?.addEventListener("click", () => goTo(activeIndex - 1));
        nextBtn?.addEventListener("click", () => goTo(activeIndex + 1));
        document.addEventListener("keydown", onKeyDown);
    }

    const initLightboxes = () => {
        document.querySelectorAll("[data-lightbox-id]").forEach((lightbox) => {
            if (lightbox.dataset.lightboxReady === "true") return;
            setupLightbox(lightbox);
            lightbox.dataset.lightboxReady = "true";
        });
    };

    document.addEventListener("DOMContentLoaded", initLightboxes);
    document.addEventListener("astro:after-swap", initLightboxes);
</script>