---
import Main from "../layouts/Main.astro";
import Image from "astro/components/Image.astro";
import h_guestbook from "../assets/headers/guestbook.png"
---

<Main>
    <div class="my-8 text-center flex flex-col guestbook-page">
        <Image src={h_guestbook} alt="Guestbook" class="custom-header" height={250} />
        <hr />
        <span class="my-8 text-xl">Hello friends! leave your mark on geggos.net!</span>
        <iframe id="ata" src="https://geggos.atabook.org/" title="geggosbook" class="guestbook-iframe shadow-md"></iframe>
    </div>
</Main>

<script src="https://cdn.jsdelivr.net/npm/@iframe-resizer/parent@5.5.9"></script>
<script>
    const resize = () => (window as any).iframeResize({
        license: 'GPLv3',
        log: 'collapsed',
    }, '#ata');
    // possible fix for astro view transitions now causing the resize to trigger
    document.addEventListener('astro:page-load', resize);
    resize();
</script>

<style>
    :global(main > .content) {
        width: 100%;
    }

    .guestbook-page {
        width: 100%;
    }
    .guestbook-iframe {
        border: 4px solid var(--bg-accent-transparent);
        border-radius: 32px;
        width: 100%;
        max-width: 840px;
        height: 100vh;
        align-self: center;
        background-color: var(--bg-accent-transparenter);
    }
    @media (max-width: 768px) {
        :global(main) {
            padding: 0 1em 3em !important;
        }
    }
</style>