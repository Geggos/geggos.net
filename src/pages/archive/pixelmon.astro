---
import Main from "../../layouts/Main.astro";
import ImageCarousel from "../../components/ImageCarousel.astro";
import ImageGrid from "../../components/ImageGrid.astro";
import ImageCollage from "../../components/ImageCollage.astro";

import badge from "../../assets/artwork/cobblemon/badge_pokeball.png"
// 2025 Images
import img_2025_bag from "../../assets/artwork/cobblemon/2025/images/bag.png";
import img_2025_banner_1 from "../../assets/artwork/cobblemon/2025/images/banner_1.png";
import img_2025_cobble_icon from "../../assets/artwork/cobblemon/2025/images/cobble_icon.png";
import img_2025_marlo from "../../assets/artwork/cobblemon/2025/images/marlo postcard.png";
import img_2025_news from "../../assets/artwork/cobblemon/2025/images/news.png";
import img_2025_rsw572 from "../../assets/artwork/cobblemon/2025/images/rsw572cgtrue.png";
import img_2025_rsw740 from "../../assets/artwork/cobblemon/2025/images/rsw740cgtrue.png";
import img_2024_results from "../../assets/artwork/cobblemon/2024/images/Results Poster.png";
import img_2024_icon from "../../assets/artwork/cobblemon/2024/images/pixelmon icon 2024.png";
import img_2024_poster from "../../assets/artwork/cobblemon/2024/images/poster_2.png";

import ss_1 from "../../assets/artwork/cobblemon/screenshots/cobblemon1.png";
import ss_2 from "../../assets/artwork/cobblemon/screenshots/cobblemon2.png";
import ss_3 from "../../assets/artwork/cobblemon/screenshots/cobblemon3.png";
import ss_4 from "../../assets/artwork/cobblemon/screenshots/cobblemon4.png";
import ss_5 from "../../assets/artwork/cobblemon/screenshots/cobblemon5.png";
import ss_6 from "../../assets/artwork/cobblemon/screenshots/cobblemon6.png";
import ss_7 from "../../assets/artwork/cobblemon/screenshots/cobblemon7.png";
import ss_8 from "../../assets/artwork/cobblemon/screenshots/cobblemon8.png";
import ss_9 from "../../assets/artwork/cobblemon/screenshots/cobblemon9.png";
import ss_10 from "../../assets/artwork/cobblemon/screenshots/cobblemon10.png";

// 2025 Icons
import icon_2025_mason from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_MASON.png";
import icon_2025_charlie from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_charlie.png";
import icon_2025_chef from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_chef.png";
import icon_2025_eli from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_eli.png";
import icon_2025_geggos from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_geggos.png";
import icon_2025_kiri from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_kiri.png";
import icon_2025_lehgo from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_lehgo.png";
import icon_2025_nasa from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_nasa.png";
import icon_2025_pink from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_pink.png";
import icon_2025_plasma from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_plasma.png";
import icon_2025_pobiii from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_pobiii.png";
import icon_2025_rhi from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_rhi.png";
import icon_2025_skully from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_skully.png";
import icon_2025_sync from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_sync.png";
import icon_2025_tori from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_tori.png";
import icon_2025_yehn from "../../assets/artwork/cobblemon/2025/icons/cobblemon_icon_yehn.png";

// 2024 Icons
import icon_2024_eli from "../../assets/artwork/cobblemon/2024/icons/Challanger Eli.png";
import icon_2024_skully from "../../assets/artwork/cobblemon/2024/icons/Challanger Skully.png";
import icon_2024_lehgoify from "../../assets/artwork/cobblemon/2024/icons/Cosplay Lehgoify.png";
import icon_2024_chef from "../../assets/artwork/cobblemon/2024/icons/Easel Chef.png";
import icon_2024_kiri from "../../assets/artwork/cobblemon/2024/icons/Easel Kiri.png";
import icon_2024_mason from "../../assets/artwork/cobblemon/2024/icons/Flameseeker Mason.png";
import icon_2024_plasma from "../../assets/artwork/cobblemon/2024/icons/Frostseeker Plasma.png";
import icon_2024_charlie from "../../assets/artwork/cobblemon/2024/icons/LOVENOTE Charlie.png";
import icon_2024_pink from "../../assets/artwork/cobblemon/2024/icons/LOVENOTE Pink.png";
import icon_2024_geggos from "../../assets/artwork/cobblemon/2024/icons/Trainer Geggos.png";
import icon_2024_nasa from "../../assets/artwork/cobblemon/2024/icons/Trainer Nasa.png";

const col1 = [
    { src: img_2025_marlo, alt: "A postcard themed invite sent to each member of the server - art by @halfcharr" },
    { src: img_2025_bag, alt: "A custom Pokemart logo, drawn for the pokemart in Sao Marlo - art by @halfcharr" },
    { src: img_2024_icon, alt: "The server icon from our first pixelmon playthrough, themed as a mudkip with Geggos' hair - art by @halfcharr" },
];

const col2 = [
    { src: img_2025_banner_1, alt: "A banner used in discord and on Geggos.net showing the spawn town of Sao Marlo - art by @halfcharr" },
    { src: img_2025_cobble_icon, alt: "The server icon for the Minecraft server, themed after a mudkip beach ball - art by @halfcharr" },
    { src: img_2025_rsw572, alt: "The poster base for tournaments in Sao Marlo. Many tournaments were planned, but only one happened - art by @halfcharr" },
    { src: badge, alt: "The button used on Geggos.net's old homepage to get to the Cobblemon/Pixelmon section - art by @halfcharr" },
];

const col3 = [
    { src: img_2025_rsw740, alt: "A custom Pokecenter logo, drawn for the pokecenter in Sao Marlo - art by @halfcharr" },
    { src: img_2025_news, alt: "A newspaper from Sao Marlo, used to announce news on Geggos.net for the server - art by @halfcharr" },
    { src: img_2024_poster, alt: "The poster for tournaments at Mouro town Arena, one tournament was held to close out the server - art by @halfcharr" },
];

const artworkColumns = [col1, col2, col3];
const artworkGrid = artworkColumns.flat();

const screenshots = [
    { src: ss_9, alt: "A picture of beautiful Sao Marlo, just before everyone arrived." },
    { src: ss_10, alt: "Everyone gathering for the opening of the server, on the Sao Marlo beach." },
    { src: ss_1, alt: "Geggos, Lehgo & Max watching Italian brainrot in our Italy inspired server spawn." },
    { src: ss_6, alt: "Lehgo carrying his teammate as a makeshift backpack." },
    { src: ss_8, alt: "Lehgo's Air Taxi service!" },
    { src: ss_7, alt: "Geggos & Pink with their plushie collection." },
    { src: ss_4, alt: "Geggos, Lehgo, Tori & Plasma grief Mason's house, making \"moss monsters\" and filling the walls with food videos." },
    { src: ss_3, alt: "Lehgo has made a mistake." },
    { src: ss_2, alt: "Results from the Sao Marlo tournament, Rhioker placed first." },
    { src: ss_5, alt: "Everyone who took part in Sao Marlo's tournament together at the podium." },
];

const icons2025 = [
    { src: icon_2025_mason, alt: "Cobblemon 2025 - Mason - art by @halfcharr" },
    { src: icon_2025_plasma, alt: "Cobblemon 2025 - Plasma - art by @halfcharr" },
    { src: icon_2025_kiri, alt: "Cobblemon 2025 - Kiri - art by @halfcharr" },
    { src: icon_2025_yehn, alt: "Cobblemon 2025 - Yehn - art by @halfcharr" },
    { src: icon_2025_chef, alt: "Cobblemon 2025 - Cheffic - art by @halfcharr" },
    { src: icon_2025_rhi, alt: "Cobblemon 2025 - Rhioker - art by @halfcharr" },
    { src: icon_2025_tori, alt: "Cobblemon 2025 - Tori - art by @halfcharr" },
    { src: icon_2025_geggos, alt: "Cobblemon 2025 - Geggos - art by @halfcharr" },
    { src: icon_2025_lehgo, alt: "Cobblemon 2025 - Lehgo - art by @halfcharr" },
    { src: icon_2025_pink, alt: "Cobblemon 2025 - Pink - art by @halfcharr" },
    { src: icon_2025_charlie, alt: "Cobblemon 2025 - Charlie - art by @halfcharr" },
    { src: icon_2025_pobiii, alt: "Cobblemon 2025 - Pobiii - art by @halfcharr" },
    { src: icon_2025_skully, alt: "Cobblemon 2025 - Skully - art by @halfcharr" },
    { src: icon_2025_nasa, alt: "Cobblemon 2025 - Nasa - art by @halfcharr" },
    { src: icon_2025_sync, alt: "Cobblemon 2025 - Sync - art by @halfcharr" },
    { src: icon_2025_eli, alt: "Cobblemon 2025 - Eli - art by @halfcharr" },
];

const icons2024 = [

    { src: icon_2024_mason, alt: "Pixelmon 2024 - Mason - art by @halfcharr" },
    { src: icon_2024_plasma, alt: "Pixelmon 2024 - Plasma - art by @halfcharr" },
    { src: icon_2024_kiri, alt: "Pixelmon 2024 - Kiri - art by @halfcharr" },
    { src: icon_2024_pink, alt: "Pixelmon 2024 - Pink - art by @halfcharr" },
    { src: icon_2024_geggos, alt: "Pixelmon 2024 - Geggos - art by @halfcharr" },
    { src: icon_2024_lehgoify, alt: "Pixelmon 2024 - Lehgo - art by @halfcharr" },
    { src: icon_2024_chef, alt: "Pixelmon 2024 - Cheffic - art by @halfcharr" },
    { src: icon_2024_nasa, alt: "Pixelmon 2024 - Nasa - art by @halfcharr" },
    { src: icon_2024_eli, alt: "Pixelmon 2024 - Eli - art by @halfcharr" },
    { src: icon_2024_charlie, alt: "Pixelmon 2024 - Charlie - art by @halfcharr" },
    { src: icon_2024_skully, alt: "Pixelmon 2024 - Skully - art by @halfcharr" },

];
---

<Main>
    <div class="my-8 text-center flex flex-col gap-4">
        <a href="/archive" class="fancy text-lg self-center">← Back</a>
        <h1>Pixelmon / Cobblemon</h1>

        <section class="mt-8 flex flex-col gap-2">
            <h2 class="font-cute text-2xl accent-secondary font-semibold">Banners, Posters and More!</h2>
            <hr>
            <section class="self-center">
                <ImageCollage images={artworkGrid} columns={artworkColumns} columnCount={3} gap="1rem" outline={false} maxImageWidth={300} maxImageHeight={400} />
            </section>
        </section>

        <section class="mt-8 flex flex-col gap-2">
            <h2 class="font-cute text-2xl accent-secondary font-semibold">Cobblemon 2025 Icons</h2>
            <hr>
            <ImageGrid images={icons2025} aspectRatio="1 / 1" maxImageHeight="250" maxImageWidth="250" outline={false} />
        </section>

        <section class="mt-8 flex flex-col gap-2">
            <h2 class="font-cute text-2xl accent-secondary font-semibold">Pixelmon 2024 Icons</h2>
            <hr>
            <ImageGrid images={icons2024} aspectRatio="1 / 1" maxImageHeight="200" maxImageWidth="200" outline={false} />
        </section>

        <section class="mt-16 flex flex-col gap-2">
            <h2 class="font-cute text-2xl accent-secondary font-semibold">Screenshots</h2>
            <ImageCarousel images={screenshots} />
        </section>
    </div>
</Main>
