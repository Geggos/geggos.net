---
import Main from "../layouts/Main.astro";
import { Image } from "astro:assets";
import GalleryEntry from "../components/GalleryEntry.astro";
import h_gallery from "../assets/headers/gallery.png"
import { galleries } from "../data/gallery";
---

<Main>
    <div class="my-8 text-center flex flex-col">
        <Image src={h_gallery} alt="Gallery" class="custom-header" height={250} />
        <hr />
        <span class="my-8 font-cute text-xl">Collections of my greatest memories captured through art, screenshots and more!</span>
        <div class="gallery-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 self-center">
            {galleries.map((gallery) => (
                <GalleryEntry
                    image={gallery.image}
                    label={gallery.label}
                    alt={gallery.alt}
                    classes={gallery.classes}
                    href={gallery.href}
                />
            ))}
        </div>
    </div>
</Main>