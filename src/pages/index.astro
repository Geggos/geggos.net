---
export const prerender = false;

import Main from "../layouts/Main.astro";
import { Image } from "astro:assets";
import geggobanner from "../assets/geggobanner.png";
import LetterboxdWidget from "../components/LetterboxdWidget.astro";
import DiscordWidget from "../components/DiscordWidget.astro";
import TimeWidget from "../components/TimeWidget.astro";
import ProjectWidget from "../components/ProjectWidget.astro";

---
<Main>
    <div class="image-container flex flex-col items-center justify-end w-full overflow-hidden">
        <Image
            src={geggobanner}
            alt="a banner of Geggos and his friends"
            class="index-banner"
            width={2048}
            height={940}
        />
    </div>
    <div class="my-8 text-center flex flex-col md:px-6">
        <h1>Welcome to Geggos.net!</h1>
        <hr />
        <div class="mt-8 index-content">
            <div class="discord-widget">
                <DiscordWidget />
            </div>
            <div class="time-widget">
                <TimeWidget />
            </div>
            <div class="letterboxd-widget">
                <LetterboxdWidget />
            </div>
            <div class="project-widget">
                <ProjectWidget />
            </div>
        </div>
    </div>
</Main>

<style>
    .index-banner {
        object-fit: cover;
        object-position: center top;
        width: 100%;
        height: 100%;
        pointer-events: none;
        user-select: none;
        max-width: 1300px;
    }

    .image-container {
        pointer-events: none;
        user-select: none;
        height: 400px;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        background-color: rgb(255, 245, 255);
        border-bottom: 4px solid var(--bg-accent-transparent);
    }

    @media (max-width: 768px) {
        .image-container {
            height: 250px;
        }
        .index-banner {
            height: 95%;
        }
    }

    .index-content {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        width: 100%;
        align-items: stretch;
    }

    .index-content > * {
        min-width: 0;
    }

    @media (min-width: 769px) {
        .index-content {
            grid-template-columns: 1fr 1fr;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        .time-widget,
        .project-widget,
        .letterboxd-widget {
            height: 100%;
            display: flex;
        }

        .time-widget {
            grid-column: 2;
            grid-row: 1 / 2;
        }

        .project-widget {
            grid-column: 2;
            grid-row: 2 / 3;
        }

        .letterboxd-widget {
            grid-column: 1;
            grid-row: 2 / 3;
        }
    }

    @media (hover:hover){
        h1:hover {
            transform: rotate(-0.5deg) !important;
        }
        h1:active {
            transform: scale(0.95) !important;
        }
    }

</style>
