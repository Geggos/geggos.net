---
import Main from "../../layouts/Main.astro";
import { Image } from "astro:assets";
import buh from "../../assets/wip.png";
import h_blog from "../../assets/headers/blog.png"
---

<Main>
    <div class="my-8 text-center flex flex-col">
        <Image src={h_blog} alt="Blog" class="custom-header" height={250} />
        <hr />
        <span class="my-8 text-xl">Thoughts, rants and gossip all from the mind of a Geggos.</span>
        <Image
            src={buh}
            width={300}
            height={300}
            alt="the buh is working very hard."
            class="self-center"
        />
        <span>buh is still working on this...</span>
    </div>
</Main>