---
import Main from "../layouts/Main.astro";
import { Image } from "astro:assets";
import h_projects from "../assets/headers/projects.png"
import ProjectEntry from "../components/ProjectEntry.astro";
import { projects } from "../data/projects";
---

<Main>
    <div class="my-8 text-center flex flex-col">
        <Image src={h_projects} alt="Projects" class="custom-header" height={250} />
        <hr />
        <span class="my-8 font-cute text-xl">What is Geggos up to?</span>
        <div class="flex flex-col gap-2">
            {projects.map((project) => (
                <ProjectEntry
                    name={project.name}
                    description={project.description}
                    tags={project.tags}
                    image={project.image}
                    imageAlt={project.imageAlt}
                    imageClass={project.imageClass}
                    url={project.url}
                />
            ))}
        </div>
    </div>
</Main>