---
import Main from "../layouts/Main.astro";
import { Image } from "astro:assets";
import h_archive from "../assets/headers/archive.png"
import ProjectEntry from "../components/ProjectEntry.astro";
import { archiveProjects } from "../data/projects";
---

<Main>
    <div class="my-8 text-center flex flex-col">
        <Image src={h_archive} alt="Archive" class="custom-header" height={250} />
        <hr />
        <span class="my-8 font-cute text-xl">Walk back through memory lane with an archive of old events, galleries and projects.</span>
        <div class="flex flex-col gap-2">
            {archiveProjects.map((project) => (
                <ProjectEntry
                    name={project.name}
                    description={project.description}
                    tags={project.tags}
                    image={project.image}
                    imageAlt={project.imageAlt}
                    imageClass={project.imageClass}
                    url={project.url}
                />
            ))}
        </div>
    </div>
</Main>